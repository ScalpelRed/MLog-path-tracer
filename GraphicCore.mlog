set procIndex 0
set procCount 525

AWAIT_MEMORY:
    set memMain bank1
    jump AWAIT_MEMORY strictEqual memMain null
read syncCommand memMain 0
jump SYNC_AWAIT_COMMAND always 0 0 # it is assumed CPU won't send a command until all GPUs are present

# before sending a command, CPU should set syncReply to 0
# if syncReply is equal to this GPU's index, we increment syncReply
# when last GPU increases syncReply, it becomes equal to procCount and all GPUs are ready
SYNC_COMMAND_DONE:
    read t1 memMain 1
    jump SYNC_COMMAND_DONE notEqual t1 procIndex
#jump _NORESETGRAPHICS always 0 0
    op abs t2 syncCommand 0
    jump _NORESETGRAPHICS notEqual t2 1
    draw color 255 000 255 255 0 0
    draw rect pxL pyL 1 1 0 0
    drawflush dispMain
_NORESETGRAPHICS:
op add t1 t1 1
write t1 memMain 1

SYNC_AWAIT_COMMAND:
    read t1 memMain 0
    jump SYNC_AWAIT_COMMAND equal t1 syncCommand
set syncCommand t1
op abs t1 syncCommand 0
jump SYNC_AWAIT_COMMAND equal t1 0
jump COMM_RESET equal t1 1
jump COMM_RENDER_FRAME equal t1 2
jump SYNC_COMMAND_DONE always 0 0

COMM_RESET:
    # calculating render area
    op mul t1 176 176
    op div pcH t1 procCount
    op max pcH pcH 1 # pixels per GPU
    # if render area is outside the screen, we need to decrease pcH
    # if area is fully outside, pcH will be negative, and no pixels will be rendered
    op mul t2 pcH procIndex
    op add t2 t2 pcH
    op sub t2 t2 t1
    op max t2 t2 0
    op sub pcH pcH t2
    # start pixel coords
    op mul t1 pcH procIndex
    op mod pxL t1 176
    op div pyL t1 176
    op floor pyL pyL 0

    set dispMain display1
    set frameAlpha 255 # first frame will be opaque
    jump SYNC_COMMAND_DONE always 0 0

COMM_RENDER_FRAME:
    # getting scene parameters
    read matArr memMain 2
    read matCount memMain matArr
    set matSize 7
    read sphereArr memMain 3
    read sphereCount memMain sphereArr
    set sphereSize 5
    read yplaneArr memMain 4
    read yplaneCount memMain yplaneArr
    set yplaneSize 4

    read bgEmitR memMain 5
    read bgEmitG memMain 6
    read bgEmitB memMain 7
    read bgStarsR memMain 8
    read bgStarsG memMain 9
    read bgStarsB memMain 10
    read bgStarsThreshold memMain 11
    read bgStarsSize memMain 12
    read bounceCount memMain 13
    read rayOriginShift memMain 14

    # render starts
    set pc pcH
    set px pxL
    set py pyL
    NEXT_PIXEL:
        set rayOrigX 0.0
        set rayOrigY 0.0
        set rayOrigZ 0.0
        op sub rayDirX px 88
        op sub rayDirY py 88
        set rayDirZ 88
        op mul t1 rayDirX rayDirX
        op mul t2 rayDirY rayDirY
        op add t1 t1 t2
        op mul t2 rayDirZ rayDirZ
        op add t1 t1 t2
        op sqrt t1 t1 0
        op div rayDirX rayDirX t1
        op div rayDirY rayDirY t1
        op div rayDirZ rayDirZ t1
        set resEmitR 0.0
        set resEmitG 0.0
        set resEmitB 0.0
        set resReflR 1.0
        set resReflG 1.0
        set resReflB 1.0

        set bounceInd 0
        NEXT_BOUNCE:
            # render is a long operation, so we should handle stop command here
            # putting it here slows render, but it's the only way to stop in case of large number of bounces
            read syncCommand memMain 0
            jump SYNC_COMMAND_DONE equal syncCommand 0

            set bestDist 9999
            set bestNormX 0
            set bestNormY 0
            set bestNormZ 0
            set bestMat 0

            jump SPHERES_DONE lessThanEq sphereCount 0
            set sphereInd 0
            op add sphere sphereArr 1
            NEXT_SPHERE: # https://habr.com/ru/articles/533932/
                read spherePosX memMain sphere
                op add spherePtr sphere 1
                read spherePosY memMain spherePtr
                op add spherePtr spherePtr 1
                read spherePosZ memMain spherePtr
                op add spherePtr spherePtr 1
                read sphereRad memMain spherePtr

                # L = rayOrig - spherePos
                op sub Lx rayOrigX spherePosX
                op sub Ly rayOrigY spherePosY
                op sub Lz rayOrigZ spherePosZ
                op mul a  rayDirX rayDirX
                # a = dot(rayDir, rayDir)
                op mul t1 rayDirY rayDirY
                op mul t2 rayDirZ rayDirZ
                op add a a t1
                op add a a t2
                # b = 2.0 * dot(L, rayDir)
                op mul b  Lx rayDirX
                op mul t1 Ly rayDirY
                op mul t2 Lz rayDirZ
                op add b b t1
                op add b b t2
                op mul b b 2
                # c = dot(L, L) - sphereRad^2
                op mul c  Lx Lx
                op mul t1 Ly Ly
                op mul t2 Lz Lz
                op add c c t1
                op add c c t2
                op mul t1 sphereRad sphereRad
                op sub c c t1
                # D = b^2 - 4*a*c
                op mul D b b
                op mul t1 4.0 a
                op mul t1 t1 c
                op sub D D t1
                jump SPHERE_NOT_CLOSER lessThan D 0.0 # if D < 0 - no hit
                # dist = -b - sqrt(D)
                op sqrt t1 D 0
                op sub dist 0 b
                op sub dist dist t1
                jump SPHERE_HIT greaterThan dist 0.0 # if dist > 0 - it's distance
                # dist = -b + sqrt(D)
                op mul t1 t1 2.0
                op add dist dist t1
                jump SPHERE_NOT_CLOSER lessThan dist 0.0 # if this time dist < 0 - no hit

                SPHERE_HIT:
                # dist /= (2 * a)
                op mul dist dist 0.5
                op div dist dist a
                jump SPHERE_NOT_CLOSER greaterThan dist bestDist

                set bestDist dist
                # normal = normalize(rayDir * dist + L)
                op mul bestNormX rayDirX dist
                op mul bestNormY rayDirY dist
                op mul bestNormZ rayDirZ dist
                op add bestNormX bestNormX Lx
                op add bestNormY bestNormY Ly
                op add bestNormZ bestNormZ Lz
                op mul t1 bestNormX bestNormX
                op mul t2 bestNormY bestNormY
                op add t1 t1 t2
                op mul t2 bestNormZ bestNormZ
                op add t1 t1 t2
                op sqrt t1 t1 0
                op div bestNormX bestNormX t1
                op div bestNormY bestNormY t1
                op div bestNormZ bestNormZ t1
                # reading material
                op add spherePtr spherePtr 1
                read bestMat memMain spherePtr

                SPHERE_NOT_CLOSER:
                op add sphere sphere sphereSize
                op add sphereInd sphereInd 1
                jump NEXT_SPHERE lessThan sphereInd sphereCount
            SPHERES_DONE:

            jump YPLANES_DONE lessThanEq yplaneCount 0
            op abs t1 rayDirY rayDirY
            jump YPLANES_DONE lessThanEq t1 0.0001 # ray is parallel to Y-plane
            set yplaneInd 0
            op add yplane yplaneArr 1
            NEXT_YPLANE:
                read yplaneY memMain yplane
                op sub dist yplaneY rayOrigY
                op div dist dist rayDirY
                jump YPLANE_NOT_CLOSER lessThan dist 0 # no hit - plane is behind the camera
                jump YPLANE_NOT_CLOSER greaterThan dist bestDist

                set bestDist dist
                # bestNorm = (0; -sign(rayDirY); 0)
                op abs t1 rayDirY 0
                op sub t1 0 t1
                op div bestNormY rayDirY t1
                set bestNormX 0
                set bestNormZ 0
                # reading material
                # it uses checker pattern based on point XZ position
                # we calculate intersection point and local material index
                # (local material index is 0/1 - mat0/mat1)
                op add yplanePtr yplane 1
                read yplaneMW memMain yplanePtr
                op mul t1 rayDirX dist
                op mul t2 rayDirZ dist
                op add t1 rayOrigX t1 # (t1; t2) - XZ intersection point
                op add t2 rayOrigZ t2
                op div t1 t1 yplaneMW
                op div t2 t2 yplaneMW
                op floor t1 t1 0
                op floor t2 t2 0 # (t1; t2) - integer coords in checker pattern
                op add t1 t1 t2
                op mul t2 t1 0.5 # mat = t1 - 2 * floor(t1 / 2)
                op floor t2 t2 0
                op mul t2 t2 2.0
                op sub t1 t1 t2
                op add yplanePtr yplanePtr 1
                op add yplanePtr yplanePtr t1
                read bestMat memMain yplanePtr

                YPLANE_NOT_CLOSER:
                op add yplane yplane yplaneSize
                op add yplaneInd yplaneInd 1
                jump NEXT_YPLANE lessThan yplaneInd yplaneCount
            YPLANES_DONE:

            jump NO_HIT greaterThanEq bestDist 9999
            op mul mat matSize bestMat
            op add mat mat 1
            op add mat mat matArr
            read emitR memMain mat
            op add matPtr mat 1
            read emitG memMain matPtr
            op add matPtr matPtr 1
            read emitB memMain matPtr
            op add matPtr matPtr 1
            read reflR memMain matPtr
            op add matPtr matPtr 1
            read reflG memMain matPtr
            op add matPtr matPtr 1
            read reflB memMain matPtr
            op add matPtr matPtr 1
            read rough memMain matPtr
            # resEmit += resRefl * emit
            op mul t1 resReflR emitR
            op add resEmitR resEmitR t1
            op mul t1 resReflG emitG
            op add resEmitG resEmitG t1
            op mul t1 resReflB emitB
            op add resEmitB resEmitB t1
            # resRefl *= refl
            op mul resReflR resReflR reflR
            op mul resReflG resReflG reflG
            op mul resReflB resReflB reflB
            # applying roughness
            # getting a random vector, not normalizing it for now
            op rand randX 2.0 0
            op rand randY 2.0 0
            op rand randZ 2.0 0
            op sub randX randX 1.0
            op sub randY randY 1.0
            op sub randZ randZ 1.0
            # if rand isn't in the same hemisphere as normal, we negate it
            op mul t1 randX bestNormX # dot(rand, bestNorm)
            op mul t2 randY bestNormY
            op add t1 t1 t2
            op mul t2 randZ bestNormZ
            op add t1 t1 t2
            jump NO_RAND_NEGATION greaterThanEq t1 0
            op sub randX 0 randX
            op sub randY 0 randY
            op sub randZ 0 randZ
            NO_RAND_NEGATION:
            # bestNorm = bestNorm * (1 - rough) + rand * rough
            op sub t1 1.0 rough
            op mul bestNormX bestNormX t1
            op mul bestNormY bestNormY t1
            op mul bestNormZ bestNormZ t1
            op mul randX randX rough
            op mul randY randY rough
            op mul randZ randZ rough
            op add bestNormX bestNormX randX
            op add bestNormY bestNormY randY
            op add bestNormZ bestNormZ randZ
            # normalizing bestNorm
            # That's why we didn't normalized rand - interpolation of two normalized vectors
            # don't always give normalized result, so we'd just waste cycles on rand
            op mul t1 bestNormX bestNormX
            op mul t2 bestNormY bestNormY
            op add t1 t1 t2
            op mul t2 bestNormZ bestNormZ
            op add t1 t1 t2
            op sqrt t1 t1 0
            op div bestNormX bestNormX t1
            op div bestNormY bestNormY t1
            op div bestNormZ bestNormZ t1
            # rayOrigX += rayDirX * bestDist + bestNormX * rayOriginShift
            op mul t1 rayDirX bestDist
            op add rayOrigX rayOrigX t1
            op mul t1 bestNormX rayOriginShift
            op add rayOrigX rayOrigX t1
            op mul t1 rayDirY bestDist
            op add rayOrigY rayOrigY t1
            op mul t1 bestNormY rayOriginShift
            op add rayOrigY rayOrigY t1
            op mul t1 rayDirZ bestDist
            op add rayOrigZ rayOrigZ t1
            op mul t1 bestNormZ rayOriginShift
            op add rayOrigZ rayOrigZ t1
            # rayDir -= 2 * dot(rayDir, bestNorm) * bestNorm
            op mul t1 rayDirX bestNormX
            op mul t2 rayDirY bestNormY
            op add t1 t1 t2
            op mul t2 rayDirZ bestNormZ
            op add t1 t1 t2
            op mul t1 t1 2.0
            op mul bestNormX bestNormX t1 # bestNorm *= t1
            op mul bestNormY bestNormY t1
            op mul bestNormZ bestNormZ t1
            op sub rayDirX rayDirX bestNormX
            op sub rayDirY rayDirY bestNormY
            op sub rayDirZ rayDirZ bestNormZ
            jump HIT_RES_RESOLVED always 0 0

            NO_HIT:
            # getting noise for stars
            # https://www.desmos.com/3d/t0vokuizxd
            # skycoord = (ap, at);  (ap - phi, at - theta)
            # at = arctan(z, sqrt(x^2 + y^2)) = arctan(z, sqrt(1 - z^2)), assuming (x, y, z) = rayDir is normalized
            op mul t1 rayDirZ rayDirZ
            op sub t1 1.0 t1
            op sqrt t1 t1 0
            op angle at t1 rayDirZ
            # at = bgStarsSize * floor(at / bgStarsSize)
            op div at at bgStarsSize
            op floor at at 0
            op mul at at bgStarsSize
            # ap = arctan(y, x) * abs(cos(at))
            op angle t1 rayDirX rayDirY
            op cos t2 at 0
            op abs t2 t2 0
            op mul ap t1 t2
            # ap = bgStarsSize * floor(ap / bgStarsSize)
            op div ap ap bgStarsSize
            op floor ap ap 0
            op mul ap ap bgStarsSize
            # noise = fract(sin(ap * 12.9898 + at * 78.233) * 43758.5453123)
            op mul t1 ap 12.9898
            op mul t2 at 78.2330
            op add t1 t1 t2
            op sin t1 t1 0
            op mul t1 t1 43758.5453123
            op floor t2 t1 0
            op sub t1 t1 t2
            jump IS_STAR lessThanEq t1 bgStarsThreshold
                # resEmit += resRefl * bgEmit
                op mul t1 resReflR bgEmitR
                op add resEmitR resEmitR t1
                op mul t1 resReflG bgEmitG
                op add resEmitG resEmitG t1
                op mul t1 resReflB bgEmitB
                op add resEmitB resEmitB t1
                jump STARS_RESOLVED always 0 0
            IS_STAR:
                # resEmit += resRefl * bgStars
                op mul t1 resReflR bgStarsR
                op add resEmitR resEmitR t1
                op mul t1 resReflG bgStarsG
                op add resEmitG resEmitG t1
                op mul t1 resReflB bgStarsB
                op add resEmitB resEmitB t1
            STARS_RESOLVED:
            # no further color changes
            set resReflR 0.0
            set resReflG 0.0
            set resReflB 0.0

            HIT_RES_RESOLVED:
            op add bounceInd bounceInd 1
            jump NEXT_BOUNCE lessThan bounceInd bounceCount
        # pixel color = clamp(0, resEmit * 255, 255)
        op mul resEmitR resEmitR 255
        op min resEmitR resEmitR 255
        op max resEmitR resEmitR 0
        op mul resEmitG resEmitG 255
        op min resEmitG resEmitG 255
        op max resEmitG resEmitG 0
        op mul resEmitB resEmitB 255
        op min resEmitB resEmitB 255
        op max resEmitB resEmitB 0
        draw color resEmitR resEmitG resEmitB frameAlpha 0 0
        draw rect px py 1 1 0 0
        drawflush dispMain
        op sub pc pc 1
        jump RENDER_END lessThanEq pc 0
        op add px px 1
        jump NEXT_PIXEL lessThan px 176
        set px 0
        op add py py 1
	    jump NEXT_PIXEL always 0 0
    RENDER_END:
    set frameAlpha 127 # other frames are mixed with previous
    jump SYNC_COMMAND_DONE always 0 0