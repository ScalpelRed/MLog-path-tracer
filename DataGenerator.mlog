set swReset switch1
set memRom bank1

sensor resetPrev swReset @enabled
RESET_WAIT:
	sensor resetCur swReset @enabled
	jump RESET_WAIT equal resetCur resetPrev
set resetPrev resetCur

set pointerCount 4

# Background data (not array!)
set bgData pointerCount
# Format skyR skyG skyB noiseR noiseG noiseB noiseThreshold (7 nums)
set bgDataSize 7
write bgData memRom 0

set bgDataPtr bgData
write 0 memRom bgDataPtr # bg color
op add bgDataPtr bgDataPtr 1
write 0 memRom bgDataPtr
op add bgDataPtr bgDataPtr 1
write 0.5 memRom bgDataPtr
op add bgDataPtr bgDataPtr 1
write 1 memRom bgDataPtr # noise color (can also be used for stars with high threshold)
op add bgDataPtr bgDataPtr 1
write 1 memRom bgDataPtr
op add bgDataPtr bgDataPtr 1
write 1 memRom bgDataPtr
op add bgDataPtr bgDataPtr 1
write 0.95 memRom bgDataPtr # noise threshold


# Materials
op add matArr bgData bgDataSize
# Format emit_r emit_g emit_b color_r color_g color_b roughness (7 nums)
set matSize 7
set matCount 3
write matArr memRom 1 # materials array pointer
write matCount memRom matArr # array starts with length
set matPtr matArr

# (0) red emission
op add matPtr matPtr 1 # emit
write 1 memRom matPtr
op add matPtr matPtr 1
write 0 memRom matPtr
op add matPtr matPtr 1
write 0 memRom matPtr
op add matPtr matPtr 1 # refl
write 0 memRom matPtr
op add matPtr matPtr 1
write 0 memRom matPtr
op add matPtr matPtr 1
write 0 memRom matPtr
op add matPtr matPtr 1 # rough
write 0 memRom matPtr

# (1) green emission
op add matPtr matPtr 1 # emit
write 0 memRom matPtr
op add matPtr matPtr 1
write 1 memRom matPtr
op add matPtr matPtr 1
write 0 memRom matPtr
op add matPtr matPtr 1 # refl
write 0 memRom matPtr
op add matPtr matPtr 1
write 0 memRom matPtr
op add matPtr matPtr 1
write 0 memRom matPtr
op add matPtr matPtr 1 # rough
write 0 memRom matPtr

# (2) metallic
op add matPtr matPtr 1 # emit
write 0 memRom matPtr
op add matPtr matPtr 1
write 0 memRom matPtr
op add matPtr matPtr 1
write 0 memRom matPtr
op add matPtr matPtr 1 # refl
write 0.5 memRom matPtr
op add matPtr matPtr 1
write 0.5 memRom matPtr
op add matPtr matPtr 1
write 0.5 memRom matPtr
op add matPtr matPtr 1 # rough
write 0 memRom matPtr


# Spheres
op mul sphereArr matCount matSize
op add sphereArr sphereArr 1
op add sphereArr sphereArr matArr
# Format: x y z r mat (5 nums)
set sphereSize 5
set sphereCount 1
write sphereArr memRom 2 # spheres array pointer
write sphereCount memRom sphereArr
set spherePtr sphereArr

op add spherePtr spherePtr 1 # pos
write 0 memRom spherePtr
op add spherePtr spherePtr 1
write 5 memRom spherePtr
op add spherePtr spherePtr 1
write 10 memRom spherePtr
op add spherePtr spherePtr 1 # rad
write 4.5 memRom spherePtr
op add spherePtr spherePtr 1 # mat
write 2 memRom spherePtr


# Y-planes
# Format: y mw mat0 mat1 (4 nums)
# They have a checker pattern of mat1 and mat2, mw is cell size
op mul yplaneArr sphereCount sphereSize
op add yplaneArr yplaneArr 1
op add yplaneArr yplaneArr sphereArr
set yplaneSize 4
set yplaneCount 1
write yplaneArr memRom 3 # y-planes array pointer
write yplaneCount memRom yplaneArr
set yplanePtr yplaneArr

op add yplanePtr yplanePtr 1 # y
write -10 memRom yplanePtr
op add yplanePtr yplanePtr 1 # mw
write 20 memRom yplanePtr
op add yplanePtr yplanePtr 1 # mats
write 1 memRom yplanePtr
op add yplanePtr yplanePtr 1
write 2 memRom yplanePtr


jump RESET_WAIT always 0 0