set procCount 525

AWAIT_DEVICES:
    set memMain bank1
    jump AWAIT_DEVICES strictEqual memMain null
    set swReset switch1
    jump AWAIT_DEVICES strictEqual swReset null

sensor t1 swReset @enabled
AWAIT_INITIAL_RESET:
    sensor resetState swReset @enabled
    jump AWAIT_INITIAL_RESET equal resetState t1

RESET:
# General variables
# matArr    2
# sphereArr 3
# yplaneArr 4
write 0.0 memMain 5 # bg color
write 0.4 memMain 6
write 0.8 memMain 7
write 0.4 memMain 8 # stars color
write 1.0 memMain 9
write 1.0 memMain 10
write 0.05 memMain 11 # stars threshold (if noise value is below - it's a star)
write 2 memMain 12 # stars size (degrees on sky sphere)
write 3 memMain 13 # bounce count
write 0.1 memMain 14 # along-normal shift (added to new ray origin to prevent collision in actual origin)
set gVarSize 15

# Materials
op add matArr 0 gVarSize
# Format emit_r emit_g emit_b color_r color_g color_b roughness (7 nums)
set matSize 7
set matCount 5
write matArr memMain 2 # materials array pointer
write matCount memMain matArr # array starts with length
set matPtr matArr

# (0) dark slightly rough metal
op add matPtr matPtr 1 # emit
write 0 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1 # refl
write 0.5 memMain matPtr
op add matPtr matPtr 1
write 0.5 memMain matPtr
op add matPtr matPtr 1
write 0.5 memMain matPtr
op add matPtr matPtr 1 # rough
write 0.01 memMain matPtr

# (1) green emission
op add matPtr matPtr 1 # emit
write 0 memMain matPtr
op add matPtr matPtr 1
write 1 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1 # refl
write 0 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1 # rough
write 0 memMain matPtr

# (2) dark smooth metal
op add matPtr matPtr 1 # emit
write 0 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1 # refl
write 0.5 memMain matPtr
op add matPtr matPtr 1
write 0.5 memMain matPtr
op add matPtr matPtr 1
write 0.5 memMain matPtr
op add matPtr matPtr 1 # rough
write 0.0 memMain matPtr

# (3) red glowing metal
op add matPtr matPtr 1 # emit
write 1 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1 # refl
write 0.5 memMain matPtr
op add matPtr matPtr 1
write 0.5 memMain matPtr
op add matPtr matPtr 1
write 0.5 memMain matPtr
op add matPtr matPtr 1 # rough
write 0 memMain matPtr

# (4) yellow emission
op add matPtr matPtr 1 # emit
write 1 memMain matPtr
op add matPtr matPtr 1
write 1 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1 # refl
write 0 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1
write 0 memMain matPtr
op add matPtr matPtr 1 # rough
write 0 memMain matPtr


# Spheres
op mul sphereArr matCount matSize
op add sphereArr sphereArr 1
op add sphereArr sphereArr matArr
# Format: x y z r mat (5 nums)
set sphereSize 5
set sphereCount 3
write sphereArr memMain 3 # spheres array pointer
write sphereCount memMain sphereArr
set spherePtr sphereArr

# (0) big metallic sphere
op add spherePtr spherePtr 1 # pos
write -10 memMain spherePtr
op add spherePtr spherePtr 1
write 20 memMain spherePtr
op add spherePtr spherePtr 1
write 40 memMain spherePtr
op add spherePtr spherePtr 1 # rad
write 20.0 memMain spherePtr
op add spherePtr spherePtr 1 # mat
write 2 memMain spherePtr

# (1) small red sphere
op add spherePtr spherePtr 1 # pos
write 10 memMain spherePtr
op add spherePtr spherePtr 1
write -4 memMain spherePtr
op add spherePtr spherePtr 1
write 30 memMain spherePtr
op add spherePtr spherePtr 1 # rad
write 5 memMain spherePtr
op add spherePtr spherePtr 1 # mat
write 3 memMain spherePtr

# (2) small yellow sphere
op add spherePtr spherePtr 1 # pos
write -10 memMain spherePtr
op add spherePtr spherePtr 1
write -4 memMain spherePtr
op add spherePtr spherePtr 1
write 30 memMain spherePtr
op add spherePtr spherePtr 1 # rad
write 5 memMain spherePtr
op add spherePtr spherePtr 1 # mat
write 4 memMain spherePtr


# Y-planes
# Format: y mw mat0 mat1 (4 nums)
# They have a checker pattern of mat1 and mat2, mw is cell size
op mul yplaneArr sphereCount sphereSize
op add yplaneArr yplaneArr 1
op add yplaneArr yplaneArr sphereArr
set yplaneSize 4
set yplaneCount 1
write yplaneArr memMain 4 # y-planes array pointer
write yplaneCount memMain yplaneArr
set yplanePtr yplaneArr

# (0) floor
op add yplanePtr yplanePtr 1 # y
write -10 memMain yplanePtr
op add yplanePtr yplanePtr 1 # cell width
write 20 memMain yplanePtr
op add yplanePtr yplanePtr 1 # mats
write 1 memMain yplanePtr
op add yplanePtr yplanePtr 1
write 0 memMain yplanePtr



set syncCommandAbs 0
read t1 memMain 0 # setting initial command sign to be opposite to what written in memory
op mul t1 t1 2
op add t1 t1 1
op abs t2 t1 0
op div syncCommandSign t1 t2

# application-like logic here, can be changed
NEXT_COMMAND:
    jump COMM_RESET equal syncCommandAbs 0
    jump COMM_RENDER_FRAME equal syncCommandAbs 1
    jump COMM_RENDER_FRAME equal syncCommandAbs 2
    jump NEXT_COMMAND always 0 0 # panic
STOP_RENDER:
    set syncCommandAbs 0
    write 0 memMain 0
    jump WAIT_FINISH_COMMAND always 0 0
COMM_RESET:
    sensor resetState swReset @enabled
    set dispMain display1
    draw clear 0 0 0 0 0 0
    drawflush dispMain
    set syncCommandAbs 1
    jump SEND_COMMAND always 0 0
COMM_RENDER_FRAME:
    set syncCommandAbs 2
    #jump SEND_COMMAND always 0 0

SEND_COMMAND:
    op sub syncCommandSign 0 syncCommandSign
    op mul t1 syncCommandAbs syncCommandSign
    write 0 memMain 1
    write t1 memMain 0
WAIT_FINISH_COMMAND:
    jump IGNORE_RESET notEqual syncCommandAbs 2
        sensor t1 swReset @enabled
        jump STOP_RENDER notEqual t1 resetState
    IGNORE_RESET:
    read t1 memMain 1
    jump WAIT_FINISH_COMMAND notEqual t1 procCount
jump NEXT_COMMAND always 0 0